# =================================================================
# == Environment Variables — Photography Portfolio               ==
# =================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed.

# --- Nextcloud (photo albums via WebDAV) ---
# Each folder inside Lightroom/Portfolio becomes one album.
# Generate an app password: Nextcloud → Settings → Security → App passwords
NEXTCLOUD_URL="https://cloud.your-domain.com"
NEXTCLOUD_USER="your-nextcloud-username"
NEXTCLOUD_PASSWORD="your-app-password"
# Portfolio folder relative to the sync account (a dedicated read-only user with
# the folder shared to it sees it as "Portfolio"); default "Lightroom/Portfolio"
# NEXTCLOUD_PORTFOLIO_PATH="Portfolio"
# Client project folders, as seen by the sync account (Lightroom/Clients shared to it)
# NEXTCLOUD_CLIENTS_PATH="Clients"
# Webhook paths of the clients folder in the owner's namespace
# NEXTCLOUD_WEBHOOK_CLIENTS_PREFIX="/dettinjo/files/Lightroom/Clients"
# The same folder as the owner's webhook events report it
# NEXTCLOUD_WEBHOOK_PATH_PREFIX="/owner-username/files/Lightroom/Portfolio"
# Shared secret Nextcloud's webhook sends in X-Portfolio-Webhook-Secret (min. 16 chars)
NEXTCLOUD_WEBHOOK_SECRET="generate-a-long-random-string"
# Optional: where processed photos are stored (default: MEDIA_DIR/photos, falling
# back to IMAGE_CACHE_DIR/photos if that is not writable)
# PHOTO_DIR="./.cache/photos"
# SYNC_DEBOUNCE_MS=60000      # wait this long after the last change in a folder
# SYNC_DISABLED=true          # turn the Nextcloud sync off (e.g. local UI work)

# --- Payload CMS (embedded: admin at /admin, approval workflow + reviews) ---
POSTGRES_URL="postgres://payload:password@localhost:5433/portfolio_photography"
PAYLOAD_SECRET="generate-a-long-random-string"   # required in production
MEDIA_DIR="./public/media"                      # uploads; /app/public/media in Docker
IMAGE_CACHE_DIR="./.cache/images"               # cache volume (fallback for processed photos)

# --- SMTP (contact form + transactional email) ---
# The contact form, auto-reply, and approval emails all use this transport.
SMTP_HOST="web207.dogado.net"
SMTP_PORT="465"
SMTP_USER="admin@your-domain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="photosby@your-domain.com"   # alias shown to recipients
ADMIN_EMAIL="admin@your-domain.com"    # where contact form submissions land

# --- Personal Information (Imprint & Privacy Policy) ---
NEXT_PUBLIC_FULL_NAME="Your Full Name"
NEXT_PUBLIC_EMAIL_ADDRESS="your.email@example.com"
NEXT_PUBLIC_PHONE_NUMBER="[optional]"
NEXT_PUBLIC_STREET_ADDRESS="Your Street 123"
NEXT_PUBLIC_CITY_ADDRESS="12345 Your City"

# --- Social Media ---
NEXT_PUBLIC_LINKEDIN_USERNAME="your-linkedin-username"
NEXT_PUBLIC_INSTAGRAM_USERNAME="your-instagram-username"

# --- Domain ---
NEXT_PUBLIC_PHOTOGRAPHY_DOMAIN="photos.your-domain.com"

# --- Umami Analytics ---
# Internal URL of the Umami instance (localhost in dev, host.docker.internal in prod)
UMAMI_INTERNAL_URL="http://localhost:3002"
# The website ID shown in Umami → Settings → Websites
UMAMI_WEBSITE_ID="8ba1defa-8dab-491f-bf5b-1bbc5a7396af"


# Stripe deposits (Phase 3c). Leave empty to switch online payment off.
# The webhook endpoint is https://<domain>/api/stripe/webhook with the events
# checkout.session.completed, .expired, .async_payment_succeeded,
# .async_payment_failed and charge.refunded.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Web Push (Phase 4e): generate with `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
